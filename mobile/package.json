{
  "name": "mobile",
  "version": "1.0.0",
  "main": "index.ts",
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@shopify/react-native-skia": "2.6.2",
    "expo": "~57.0.24",
    "expo-audio": "~57.0.5",
    "expo-haptics": "~57.0.3",
    "expo-sensors": "~57.0.3",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-worklets": "^0.10.1"
  },
  "devDependencies": {
    "@types/node": "^24.13.6",
    "@types/react": "~19.2.2",
    "babel-preset-expo": "^57.0.12",
    "canvaskit-wasm": "^0.41.0",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~57.0.2",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "test:guards": "tsx src/game/guards/__tests__/guardVision.test.ts",
    "sprites:templates": "tsx --tsconfig tools/sprites/tsconfig.runtime.json tools/sprites/makeTemplates.ts",
    "sprites:validate": "tsx --tsconfig tools/sprites/tsconfig.runtime.json tools/sprites/validateSprites.ts",
    "sprites:selftest": "tsx --tsconfig tools/sprites/tsconfig.runtime.json tools/sprites/validatorSelfTest.ts",
    "typecheck:tools": "tsc -p tools/sprites --noEmit",
    "sprites:extract": "tsx --tsconfig tools/sprites/tsconfig.runtime.json tools/sprites/extractSheet.ts",
    "test:locomotion": "tsx src/game/core/__tests__/footPlanting.test.ts",
    "test": "npm run test:locomotion && npm run test:guards && npm run test:rules && npm run test:global && npm run test:tilt && npm run test:maps && npm run test:playable",
    "test:maps": "node --import tsx --test src/game/levels/__tests__/tiltTestMaps.test.ts",
    "test:tilt": "node --import tsx --test src/game/input/__tests__/tilt.test.ts",
    "test:global": "tsx src/game/guards/__tests__/globalAlert.test.ts",
    "sprites:views": "tsx --tsconfig tools/sprites/tsconfig.runtime.json tools/sprites/extractViews.ts",
    "sprites:identity": "tsx --tsconfig tools/sprites/tsconfig.runtime.json tools/sprites/makeIdentityRefs.ts",
    "test:rules": "tsx src/game/__tests__/coreRules.test.ts",
    "test:playable": "node --import tsx --test src/game/__tests__/playableV1.test.ts src/game/__tests__/chapter1.test.ts",
    "lint": "expo lint"
  },
  "private": true
}
