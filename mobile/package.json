{
  "name": "mobile",
  "version": "1.0.0",
  "main": "index.ts",
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@shopify/react-native-skia": "2.6.2",
    "expo": "~57.0.27",
    "expo-asset": "~57.0.19",
    "expo-audio": "~57.0.5",
    "expo-constants": "~57.0.21",
    "expo-dev-client": "~57.0.19",
    "expo-haptics": "~57.0.3",
    "expo-iap": "^5.8.1",
    "expo-sensors": "~57.0.3",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-updates": "~57.0.25",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-google-mobile-ads": "^17.2.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-worklets": "^0.10.1"
  },
  "devDependencies": {
    "@types/node": "^24.13.6",
    "@types/react": "~19.2.2",
    "babel-preset-expo": "^57.0.12",
    "canvaskit-wasm": "^0.41.0",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~57.0.2",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "update:production": "eas update --channel production --environment production",
    "update:preview": "eas update --channel preview --environment preview",
    "typecheck": "tsc --noEmit && npm run typecheck:campaign",
    "test:guards": "tsx src/game/guards/__tests__/guardVision.test.ts",
    "sprites:templates": "tsx --tsconfig tools/sprites/tsconfig.runtime.json tools/sprites/makeTemplates.ts",
    "sprites:validate": "tsx --tsconfig tools/sprites/tsconfig.runtime.json tools/sprites/validateSprites.ts",
    "sprites:selftest": "tsx --tsconfig tools/sprites/tsconfig.runtime.json tools/sprites/validatorSelfTest.ts",
    "test:sprite-contract": "node --import tsx --test tools/sprites/footTracks.test.ts tools/locomotion/atlas.test.ts",
    "locomotion:bake": "echo See tools/locomotion/v2/README.md (Python cutout rig)",
    "locomotion:validate": "node --import tsx tools/locomotion/validate.ts assets/characters",
    "locomotion:previews": "python3 tools/locomotion/previews.py assets/characters Reports/Locomotion/previews",
    "sprites:contract": "node --import tsx tools/sprites/syncContract.ts",
    "typecheck:tools": "tsc -p tools/sprites --noEmit",
    "sprites:extract": "tsx --tsconfig tools/sprites/tsconfig.runtime.json tools/sprites/extractSheet.ts",
    "test:locomotion": "tsx src/game/core/__tests__/footPlanting.test.ts",
    "test": "npm run test:locomotion && npm run test:guards && npm run test:rules && npm run test:global && npm run test:tilt && npm run test:maps && npm run test:playable && npm run test:sprite-contract && npm run test:branding && npm run test:campaign && npm run test:theft-support && npm run test:monetization && npm run test:crash-hotfix && npm run test:environment && npm run test:doors && npm run test:ota",
    "test:campaign": "node --import tsx --test tools/campaign/validateCampaign.test.ts tools/campaign/museumQA.test.ts tools/campaign/museumFinalDesign.test.ts tools/campaign/museumDressingQA.test.ts tools/campaign/museumCentralCoverQA.test.ts tools/campaign/museumSecurityCleanupQA.test.ts tools/campaign/galleryEnvironmentDesign.test.ts tools/campaign/v3Audit.test.ts tools/campaign/v5Geometry.test.ts tools/campaign/v5MuseumGallery.test.ts tools/campaign/v5Bank.test.ts tools/campaign/curatedHeistFlows.test.ts tools/campaign/navigationRegression.test.ts tools/campaign/museumRuntimeCctvQA.test.ts tools/campaign/chapterDifficulty.test.ts tools/campaign/v101PressureAudit.test.ts tools/campaign/v11Museum.test.ts tools/campaign/v11GalleryBank.test.ts tools/campaign/v11ScopeRegression.test.ts tools/campaign/v12Runtime.test.ts src/game/progress/__tests__/campaignMigration.test.ts src/game/progress/__tests__/qaUnlock.test.ts tools/campaign/v124aRuntimeQA.test.ts tools/campaign/v124aSpatial.test.ts tools/campaign/v124bTopologyQA.test.ts tools/campaign/v124bRuntimeQA.test.ts tools/campaign/v124cTopologyQA.test.ts tools/campaign/v124cScope.test.ts tools/campaign/v124dScope.test.ts tools/campaign/v125Scope.test.ts tools/campaign/v13Scope.test.ts tools/campaign/v13Integrity.test.ts",
    "test:environment": "node --import tsx --test src/assets/environmentKit.test.ts src/game/levels/__tests__/galleryGlass.test.ts tools/environment/contract.test.ts tools/environment/catalogKit.test.ts",
    "environment:validate": "node --import tsx tools/environment/validate.ts",
    "test:branding": "node --import tsx --test src/ui/branding/*.test.ts",
    "test:ota": "node --import tsx --test src/ota/*.test.ts",
    "test:maps": "node --import tsx --test src/game/levels/__tests__/tiltTestMaps.test.ts",
    "test:tilt": "node --import tsx --test src/game/input/__tests__/tilt.test.ts src/game/input/__tests__/androidTilt.test.ts src/game/input/__tests__/calibrationHotfix.test.ts src/game/input/__tests__/tiltProfiles.test.ts src/game/input/__tests__/tiltStop.test.ts src/game/input/__tests__/controlMode.test.ts src/ui/__tests__/resultNavigation.test.ts",
    "test:global": "tsx src/game/guards/__tests__/globalAlert.test.ts && node --import tsx --test src/game/guards/__tests__/stealthV2.test.ts src/game/guards/__tests__/theftV3.test.ts src/game/guards/__tests__/alertPriority.test.ts src/game/guards/__tests__/chaseBalance.test.ts src/game/guards/__tests__/highSecurityAlarm.test.ts",
    "sprites:views": "tsx --tsconfig tools/sprites/tsconfig.runtime.json tools/sprites/extractViews.ts",
    "sprites:identity": "tsx --tsconfig tools/sprites/tsconfig.runtime.json tools/sprites/makeIdentityRefs.ts",
    "test:rules": "tsx src/game/__tests__/coreRules.test.ts",
    "test:playable": "node --import tsx --test src/game/__tests__/playableV1.test.ts src/game/__tests__/chapter1.test.ts src/game/__tests__/characterAnimation.test.ts src/game/__tests__/rightWalkTrial.test.ts src/game/__tests__/polishV52.test.ts src/game/__tests__/motionV61.test.ts",
    "lint": "expo lint",
    "test:theft-support": "node --import tsx --test src/game/audio/__tests__/audioState.test.ts src/game/world/museumBoundary.test.ts src/ui/hud/alertHud.test.ts",
    "test:monetization": "node --import tsx --test src/game/monetization/__tests__/adState.test.ts src/game/monetization/__tests__/purchases.test.ts src/game/monetization/__tests__/iapProvider.test.cjs src/ui/__tests__/removeAdsView.test.ts src/game/monetization/__tests__/adsController.test.cjs src/game/monetization/__tests__/interstitialPresentation.test.ts src/game/security/__tests__/cctv.test.ts",
    "test:crash-hotfix": "node --test src/game/guards/__tests__/workletChase.test.cjs && node --import tsx --test src/game/guards/__tests__/theftSpottedCrash.test.ts src/game/guards/__tests__/animationBounds.test.ts",
    "test:stability": "node --test src/game/world/__tests__/collisionWorklet.test.cjs && node --import tsx --test src/game/world/__tests__/collisionStability.test.ts src/game/world/__tests__/wallSlide.test.ts src/game/playground/__tests__/tapToMove.test.ts src/game/monetization/__tests__/interstitialPresentation.test.ts src/game/monetization/__tests__/adsController.test.cjs",
    "test:doors": "node --import tsx --test src/game/doors/__tests__/doors.test.ts src/game/doors/__tests__/doorIntegration.test.ts && node --test src/game/doors/__tests__/doorWorklet.test.cjs && node --test tools/campaign/v124aDoorArtWorklet.test.cjs",
    "campaign:bake": "node --import tsx tools/campaign/v13Build.ts && node --import tsx tools/campaign/buildMissionBriefs.ts",
    "campaign:snapshot": "node --import tsx tools/campaign/v13Snapshot.ts check docs/design/v13/PHASE8_SNAPSHOT_HASHES.json",
    "campaign:audit": "node --import tsx tools/campaign/v13FullAudit.ts",
    "campaign:overrides": "node --import tsx tools/campaign/v13Overrides.ts",
    "typecheck:campaign": "tsc -p tools/campaign/tsconfig.v13.json --noEmit",
    "typecheck:campaign:legacy": "tsc -p tools/campaign/tsconfig.v124b.json --noEmit",
    "postinstall": "node tools/native/ensureSkiaLibraries.cjs",
    "preandroid": "node tools/native/ensureSkiaLibraries.cjs"
  },
  "private": true
}
