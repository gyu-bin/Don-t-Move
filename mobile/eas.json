{
  "cli": {
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "ios": {
        "simulator": true
      }
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "ios": {
        "buildConfiguration": "Release"
      }
    },
    "production": {
      "autoIncrement": false,
      "channel": "production",
      "env": {
        "EXPO_PUBLIC_DM_QA_UNLOCK_ALL": "0"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
