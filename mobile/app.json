{
  "expo": {
    "name": "Don't Move",
    "slug": "dont-move",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/branding/app-icon.png",
    "userInterfaceStyle": "dark",
    "scheme": "dontmove",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/57cbe370-8574-49be-bc97-ebd973d819e1",
      "fallbackToCacheTimeout": 0,
      "checkAutomatically": "ON_LOAD",
      "enabled": true
    },
    "ios": {
      "appleTeamId": "6YASPU77L7",
      "supportsTablet": false,
      "bundleIdentifier": "com.dontmove.prototype",
      "buildNumber": "1",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#081824",
        "foregroundImage": "./assets/branding/adaptive-foreground.png"
      },
      "package": "com.dontmove.prototype",
      "versionCode": 1,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ]
    },
    "web": {
      "favicon": "./assets/branding/app-icon.png"
    },
    "plugins": [
      "expo-audio",
      "expo-iap",
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-2202662035854210~9781589386",
          "iosAppId": "ca-app-pub-2202662035854210~4428994235"
        }
      ],
      [
        "expo-sensors",
        {
          "motionPermission": "Allow Don't Move to use device motion for tilt controls."
        }
      ],
      "./plugins/withSceneLifecycle",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#081824"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "57cbe370-8574-49be-bc97-ebd973d819e1"
      }
    }
  }
}
