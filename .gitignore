*.orig.*

# Unity legacy caches (if opened from legacy-unity/)
legacy-unity/Library/
legacy-unity/Temp/
legacy-unity/Obj/
legacy-unity/Build/
legacy-unity/Builds/
legacy-unity/Logs/
legacy-unity/UserSettings/
legacy-unity/.utmp/
*.csproj
*.sln
*.slnx
*.user
*.apk
*.aab
*.ipa
